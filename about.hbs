<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>space-station-rs: third-party licenses</title>
<style>
body { font-family: sans-serif; max-width: 60em; margin: 2em auto; padding: 0 1em; }
pre { white-space: pre-wrap; background: #f4f4f4; padding: 1em; }
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>The Rust crates space-station-rs is built from, with their licenses. The project's own code
is AGPL-3.0-only (LICENSE); tgui, font and asset notices are in THIRD-PARTY-NOTICES.md and
ASSETS-LICENSE.md.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>Licenses</h2>
{{#each licenses}}
<h3 id="{{id}}">{{name}}</h3>
<p>Used by:</p>
<ul>
{{#each used_by}}
<li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
